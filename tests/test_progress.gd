extends "res://tests/suite_base.gd"

const StateScript := preload("res://GameState.gd")
const TEST_PATH := "user://ibmm_test_progress.cfg"

func run() -> void:
	suite_name = "Saved progress and settings"
	var state = StateScript.new()
	assert_eq(state.total_xp(), 0, "new player starts at zero XP")
	state.record_result(0, 425, 3, TEST_PATH)
	state.record_result(0, 100, 1, TEST_PATH)
	assert_eq(state.best_scores[0], 425, "replay preserves best score")
	assert_eq(state.medals[0], 3, "replay preserves best medal")
	assert_eq(state.total_xp(), 425, "replays do not inflate XP")
	assert_eq(state.recommended_algorithm(), 1, "next uncompleted algorithm suggested")
	state.record_courier(0, 0, 1000, 3, TEST_PATH)
	state.record_courier(0, 0, 200, 1, TEST_PATH)
	assert_eq(state.courier_scores["0:0"], 1000, "campaign preserves best score")
	assert_eq(state.courier_medals["0:0"], 3, "campaign preserves best medal")
	assert_eq(state.courier_xp(), 1000, "campaign replays cannot inflate XP")
	assert_eq(state.recommended_courier(), {"algorithm":0,"tier":1}, "campaign recommends next difficulty")
	state.sound_enabled = false
	state.music_enabled = false
	state.music_volume = 0.15
	state.record_tree(2,1,900,3,TEST_PATH)
	state.record_tree(2,1,100,1,TEST_PATH)
	assert_eq(state.tree_scores["2:1"],900,"tree replay preserves best")
	state.reduced_motion = true
	assert_eq(state.save_progress(TEST_PATH), OK, "progress can be saved")
	var restored = StateScript.new()
	restored.load_progress(TEST_PATH)
	assert_eq(restored.best_scores, state.best_scores, "scores survive reload")
	assert_eq(restored.medals, state.medals, "medals survive reload")
	assert_eq(restored.courier_scores, state.courier_scores, "campaign scores survive reload")
	assert_eq(restored.courier_medals, state.courier_medals, "campaign medals survive reload")
	assert_false(restored.sound_enabled, "sound preference persists")
	assert_false(restored.music_enabled,"separate music toggle persists")
	assert_eq(restored.music_volume,0.15,"music volume persists")
	assert_eq(restored.tree_scores,state.tree_scores,"tree results survive reload")
	assert_eq(restored.tree_medals,state.tree_medals,"tree medals survive reload")
	assert_true(restored.reduced_motion, "motion preference persists")
	var invalid := ConfigFile.new()
	invalid.set_value("scores", "0", "broken")
	invalid.set_value("scores", "1", 99999)
	invalid.set_value("medals", "1", -8)
	invalid.set_value("settings","music_volume","broken")
	invalid.set_value("tree_scores","2:2",99999)
	invalid.set_value("tree_medals","2:2","broken")
	invalid.set_value("courier_scores", "8:2", 999999)
	invalid.set_value("courier_medals", "8:2", "broken")
	invalid.save(TEST_PATH)
	restored.load_progress(TEST_PATH)
	assert_false(restored.best_scores.has(0), "malformed score ignored")
	assert_eq(restored.best_scores[1], 425, "out-of-range score clamped")
	assert_false(restored.medals.has(1), "invalid medal ignored")
	assert_eq(restored.courier_scores["8:2"], 1000, "campaign score clamped")
	assert_false(restored.courier_medals.has("8:2"), "malformed campaign medal ignored")
	assert_eq(restored.music_volume,0.22,"malformed volume restores quiet default")
	assert_eq(restored.tree_scores["2:2"],1000,"tree score is clamped")
	assert_false(restored.tree_medals.has("2:2"),"malformed tree medal ignored")
	var failed_save: Error = state.save_progress("user://ibmm_missing_directory/progress.cfg")
	assert_true(failed_save != OK and state.last_save_error == failed_save,"save errors remain available to user-facing feedback")
	DirAccess.remove_absolute(TEST_PATH)
	state.free()
	restored.free()
